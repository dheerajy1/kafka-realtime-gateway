# Node environment
NODE_ENV=development

# Json web token
JWT_SECRET=<SET_JWT_SECRET>

# Client
CLIENT_ID=<SET_CLIENT_ID>
CLIENT_SECRET=<SET_CLIENT_SECRET>

# on prem
ONPREM_DB_SERVER=localhost
ONPREM_DB_PORT=port
ONPREM_DB_DATABASE=db

ONPREM_DB_USER_PUBLIC=<SET_PUBLIC_USER>
ONPREM_DB_PASSWORD_PUBLIC=<SET_PUBLIC_PASSWORD>

ONPREM_DB_USER_SERVICE=<SET_SERVICE_USER>
ONPREM_DB_PASSWORD_SERVICE=<SET_SERVICE_PASSWORD>

# App environment
APP_NAME=kafka-api-gateway

# Kafka
KAFKA_BROKERS=localhost:port
KAFKA_CLIENT_ID=id
KAFKA_GROUP_ID=id

# Record Log Kafka topics
RECORD_LOG_WRITE_TOPIC=record-log-ingest-write-model
RECORD_LOG_READ_TOPIC=record-log-ingest-read-model
RECORD_LOG_STATUS_TOPIC=record-log-status
RECORD_LOG_WRITE_DLQ_TOPIC=record-log-ingest-write-model-dlq
RECORD_LOG_READ_DLQ_TOPIC=record-log-ingest-read-model-dlq
