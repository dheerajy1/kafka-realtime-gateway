{
  "name": "kafka-api-gateway",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx tailwindcss -i ./src/tailwind.css -o ./public/global.css && bun --env-file=.env.development --hot src/server.ts",
    "type-check": "tsc --noEmit",
    "build": "bun run clean && bunx tailwindcss -i ./src/tailwind.css -o ./public/global.css && tsc && tsc-alias && cp -r public dist/public",
    "start": "bun --env-file=.env.production dist/server.js",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "clean": "rm -rf dist/* dist/.* || true",
    "test": "bun test",
    "test:http-publish": "bun test src/routes/v1/kafka/__tests__",
    "hash": "bun src/scripts/hash.ts",
    "dev:pipeline-state-consumer": "bun --env-file=.env.development src/pipeline-state-consumer/main.ts",
    "compile:pipeline-state-consumer": "mkdir -p dist && bun --env-file=.env.development build ./src/pipeline-state-consumer/main.ts --target=bun --compile --outfile=dist/pipeline-state-consumer",
    "start:pipeline-state-consumer:binary": "./dist/pipeline-state-consumer",
    "madge:pipeline-state-consumer": "madge --ts-config tsconfig.json --extensions ts src/pipeline-state-consumer/main.ts",
    "madge:pipeline-state-consumer:json": "madge --ts-config tsconfig.json --extensions ts --json src/pipeline-state-consumer/main.ts",
    "madge:pipeline-state-consumer:circular": "madge --ts-config tsconfig.json --extensions ts --circular src/pipeline-state-consumer/main.ts",
    "build:pipeline-state-consumer": "bun --env-file=.env.development build ./src/pipeline-state-consumer/main.ts --target=bun --outfile=dist/pipeline-state-consumer.js",
    "start:pipeline-state-consumer": "bun --env-file=.env.development dist/pipeline-state-consumer.js",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:start": "docker compose -f docker/docker-compose.yml start",
    "docker:stop": "docker compose -f docker/docker-compose.yml stop",
    "docker:restart": "docker compose -f docker/docker-compose.yml restart",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f kafka-api-gateway",
    "docker:logs:clear": "sudo truncate -s 0 $(docker inspect --format='{{.LogPath}}' kafka-api-gateway)",
    "docker:rmi": "docker image rm kafka-api-gateway:latest",
    "docker:clean": "docker compose -f docker/docker-compose.yml down && docker image rm -f kafka-api-gateway:latest"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/static": "^1.4.7",
    "@types/ws": "^8.18.1",
    "elysia": "^1.4.22",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.563.0",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/bun": "^1.3.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "semantic-release": "^25.0.2",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.4.0"
  }
}
