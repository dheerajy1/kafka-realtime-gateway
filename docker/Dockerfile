# Builds the kafka-api-gateway as one standalone binary.
# The build context is the repo root, see docker/docker-compose.yml.
# public/global.css is generated by cargo docker-build before this build starts, so no Tailwind CLI is needed here.

FROM rust:1-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY src ./src
COPY public ./public
COPY xtask ./xtask

# Needs BuildKit (the default builder since Docker 23.0)
# The two cache mounts keep the downloaded crates and the build output between builds, so a code change rebuilds only the changed crates
# --locked builds exactly the versions in Cargo.lock
# The binary is named "main" in Cargo.toml and is copied out in the same step, because the cache mount is not part of the image
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked --package kafka-api-gateway \
    && cp target/release/main /app/main

# Runtime stage: only the binary and CA certificates
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/main /app/main

# The gateway runs as an unprivileged user, so a flaw in it gives no root rights inside the container
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app

USER app

EXPOSE 8089

CMD ["/app/main"]
